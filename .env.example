# Copia este archivo como ".env" y pega tu clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_tu_clave_aqui

# Modelos a probar en orden. Si el primero llega a su límite gratuito, se usa el siguiente.
# Ejecuta "python probar_gemini.py" para ver los nombres disponibles para tu cuenta.
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
